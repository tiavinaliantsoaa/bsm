<IfModule mod_rewrite.c>
    RewriteEngine On

    # If the vhost document root is the project folder instead of public/,
    # funnel every request into public/ so .env, artisan and .git stay unreachable.
    RewriteRule ^$ public/ [L]
    RewriteRule (.*) public/$1 [L]
</IfModule>

<FilesMatch "(^\.env|composer\.(json|lock)|artisan|phpunit\.xml)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
