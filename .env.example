APP_NAME="BSM-Services"
# Production: APP_ENV=production and APP_DEBUG=false
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Indian/Antananarivo
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
# Production: error
LOG_LEVEL=debug

# No database is required for the public website (all content is static).
DB_CONNECTION=sqlite

SESSION_DRIVER=file
# Production (HTTPS): true. Inferred from APP_URL when omitted.
SESSION_SECURE_COOKIE=false
SESSION_ENCRYPT=true
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Local tunnels (ngrok) only. Production: leave empty, or set OVH reverse-proxy CIDRs.
TRUSTED_PROXIES=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="contact@bsm-services.com"
MAIL_FROM_NAME="${APP_NAME}"

# Where contact form submissions should be delivered.
CONTACT_TO_ADDRESS="contact@bsm-services.com"

VITE_APP_NAME="${APP_NAME}"
