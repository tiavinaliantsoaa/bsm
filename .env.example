APP_NAME="BSM-Services"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Indian/Antananarivo
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=debug

# No database is required for the public website (all content is static).
DB_CONNECTION=sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS="contact@bsm-services.com"
MAIL_FROM_NAME="${APP_NAME}"

# Where contact form submissions should be delivered.
CONTACT_TO_ADDRESS="contact@bsm-services.com"

VITE_APP_NAME="${APP_NAME}"
